<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Week Agenda"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#88C0A4"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-Day Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:weightSum="7"
        android:background="#26292C"
        android:padding="2dp">

        <!-- Mon -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#88C0A4"/>
        </LinearLayout>

        <!-- Tue -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#88C0A4"/>
        </LinearLayout>

        <!-- Wed -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#00000000"/>
        </LinearLayout>

        <!-- Thu (today - highlighted) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="#88C0A4" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textColor="#88C0A4" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#FF5252"/>
        </LinearLayout>

        <!-- Fri -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#00000000"/>
        </LinearLayout>

        <!-- Sat -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#00000000"/>
        </LinearLayout>

        <!-- Sun -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="#78909C" android:textSize="10sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#88C0A4"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Sample Task 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="#FF5252"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deploy v0.8.1 hotfix"
                android:textColor="#E1E2E6"
                android:textSize="13sp"
                android:maxLines="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due 2:00 PM"
                android:textColor="#78909C"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#2D2F31"/>

    <!-- Sample Task 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="#FFBF00"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sprint review meeting"
                android:textColor="#E1E2E6"
                android:textSize="13sp"
                android:maxLines="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due 4:30 PM"
                android:textColor="#78909C"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
